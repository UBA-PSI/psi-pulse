# Image-Version (Commit), Produktion: gesetzt beim Deploy, lokal: latest
PULSE_TAG=latest
# Öffentliche Adresse (Links in Mails, Einbettung von pulse.js)
HOST_URL=http://localhost:3000
DB_PASSWORD=change-me
# Geheimnis für die Login-Codes im Widget, mindestens 32 Zeichen: openssl rand -hex 32
LOGIN_CODE_SECRET=dev-only-0123456789abcdef0123456789abcdef
# SMTP. Produktion: mailex.uni-bamberg.de, 587, STARTTLS Pflicht.
# Lokal mit docker-compose.dev.yml: mailpit, 1025, false
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_REQUIRE_TLS=false
EMAIL_USER=pulse
EMAIL_PASS=change-me
# Nur für `npm run dev` ohne Docker:
# DATABASE_URL=postgres://postgres:change-me@localhost:5432/postgres
# NUXT_MAIL_SECRETS_EMAIL_HOST=localhost (usw., siehe docker-compose.yml)
